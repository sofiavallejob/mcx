#N canvas 60 40 780 1180 12;
#X obj 0 0 cnv 1 780 52 empty empty mcx/mcexpr~ 20 26 0 20 #ececec #202020 0;
#X text 20 70 A signal expression that runs once per channel of a multichannel cable. Like expr~ \, but it knows which channel it is on (ch) and takes one value per channel from lists., f 72;
#X msg 40 130 \; pd dsp 1;
#X msg 150 130 \; pd dsp 0;
#X text 260 136 DSP on / off;
#X obj 20 180 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 188 1 - a detuned bank of 8 oscillators from one line;
#X obj 40 220 mcx/mcexpr~ -n 8 220 * (1 + ch * 0.004);
#X obj 40 260 osc~;
#X obj 40 300 mcx/mcsum~;
#X obj 40 340 *~ 0.05;
#X obj 40 380 dac~;
#X text 400 222 -n 8 makes 8 channels. ch is 0 to 7 \, so each oscillator is slightly higher., f 40;
#X obj 20 430 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 438 2 - one value per channel from a list;
#X msg 40 470 200 250 300 375;
#X msg 200 470 100 150 200 300;
#X obj 40 520 mcx/mcexpr~ -n 4 f1;
#X obj 40 580 mcx/mcprint~ freqs;
#X msg 260 525 bang;
#X text 400 472 a list into a control inlet gives each channel its own value. A float sets all channels. Short lists wrap around., f 40;
#X obj 20 620 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 628 3 - process a multichannel signal;
#X obj 40 660 noise~;
#X obj 140 660 osc~ 110;
#X obj 40 700 snake~ in 2;
#X obj 40 740 mcx/mcexpr~ tanh(x1 * (2 + ch * 6)) * 0.1;
#X text 420 702 x1 is the incoming channel. Here channel 2 is driven harder than channel 1., f 40;
#X obj 20 800 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 808 reference;
#X text 40 830 variables:  x1..x8 signal inlets (x = x1)  f1..f8 control inlets  ch channel index from 0  nch channel count  sr sample rate  pi. expr~ style $v1 and $f1 also work., f 76;
#X text 40 890 operators:  + - * / % ^  == != < > <= >=  && || !  ( ), f 76;
#X text 40 920 functions:  sin cos tan asin acos atan atan2 sinh cosh tanh exp log log10 log2 sqrt abs pow min max floor ceil round fmod sign wrap(v) clip(v lo hi) if(cond a b) mtof ftom dbtorms rmstodb rand(), f 76;
#X text 40 980 channels:  the output has as many channels as the widest signal input. -n N forces N. A narrower input wraps around., f 76;
#X text 40 1030 messages:  seed <n> resets rand() so a random patch can be repeated., f 76;
