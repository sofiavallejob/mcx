#X obj 20 180 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 188 example;
#X obj 40 220 mcx/mcexpr~ -n 6 0;
#X obj 40 260 mcx/mcnchs~;
#X floatatom 40 300 5 0 0 0 - - - 0;
#X msg 220 220 bang;
#X text 330 222 change the -n argument and turn DSP on again: the number updates., f 40;
