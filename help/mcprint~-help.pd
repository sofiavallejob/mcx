#N canvas 60 40 780 500 12;
#X obj 0 0 cnv 1 780 52 empty empty mcx/mcprint~ 20 26 0 20 #ececec #202020 0;
#X text 20 70 Shows what is inside a multichannel cable in the Pd window., f 72;
#X msg 40 120 \; pd dsp 1;
#X msg 150 120 \; pd dsp 0;
#X text 260 126 DSP on / off;
#X obj 20 170 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 178 example;
#X obj 40 210 mcx/mcexpr~ -n 4 ch * 0.25 + rand() * 0.01;
#X msg 40 260 bang;
#X msg 110 260 peak;
#X msg 180 260 block;
#X obj 40 310 mcx/mcprint~ test;
#X text 40 360 bang: first sample of each channel on one line. peak: the peak of each channel over one block. block: every sample \, one line per channel., f 72;
#X text 40 420 argument: a name shown in front of each line., f 72;
#X connect 7 0 11 0;
#X connect 8 0 11 0;
#X connect 9 0 11 0;
#X connect 10 0 11 0;
